# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# R2 credentials and generated manifest
.env
/manifest.json

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
.superpowers/

# R2-hosted media — served from Cloudflare at runtime, not bundled.
# Kept on disk locally as the re-upload source; only the landing cover is bundled.
/assets/audio/
/assets/stories/*
!/assets/stories/landing_page/

# generated store graphics (regenerate via scripts/make_feature_graphic.py + make_screenshots.sh)
/build/

# tool artifacts / local caches
/coverage/
/tmp/
.scratch/
.codex/
.agents/
graphify-out/
